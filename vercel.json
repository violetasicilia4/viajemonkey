{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|manifest\\.webmanifest|offline\\.html|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
